# ============================================================================
# VIPOS — Environment variables example
# ============================================================================
# Copy ke `.env` di repo root (atau `apps/backend/.env`) dan isi value asli.
# .env files di-gitignore — JANGAN commit secret asli.

# ----- Backend runtime -----
PORT=3001
NODE_ENV=development
JWT_SECRET=replace-me-with-32-byte-random-string

# ----- Database (P2-01) -----
# DATABASE_URL: runtime URL untuk Prisma client. Pakai connection pooler
# (PgBouncer) di Supabase port 6543 transaction mode.
#   format: postgresql://user:pass@host:6543/db?pgbouncer=true&connection_limit=1
# Untuk dev lokal pakai Docker Postgres:
#   docker run --rm -d -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=vipos -p 5433:5432 postgres:17-alpine
# DATABASE_URL=postgresql://postgres:dev@localhost:5433/vipos
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vipos

# DIRECT_URL: HANYA untuk `prisma migrate` (butuh prepared statements yang
# tidak compatible dengan PgBouncer transaction mode). Di Supabase, pakai
# pooler hostname dengan port 5432 (session mode) — JANGAN pakai
# `db.<projectref>.supabase.co` karena IPv6-only di free tier.
#   format: postgresql://user:pass@aws-X-region.pooler.supabase.com:5432/db
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/vipos

# Legacy SQLite fallback (deprecated setelah P2-01b cutover). Boleh override
# untuk test isolation.
# VIPOS_DB_PATH=/path/to/vipos.db

# ----- Backup (P2-01a + P2-08) -----
# Local backup directory. Cron entry: `0 2 * * * /var/www/vipos/apps/backend/scripts/backup-postgres.sh`
# BACKUP_DIR=/var/backups/vipos
# RETENTION_DAYS=14

# Optional S3-compatible offload (Cloudflare R2 / Backblaze B2 / AWS S3).
# Aktif kalau S3_BUCKET di-set; backup auto-upload setelah local dump.
# S3_BUCKET=vipos-backup
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=auto

# ----- Observability -----
# Backend Sentry (P2-05). Leave unset to no-op locally.
# SENTRY_DSN=https://...@sentry.io/...

# Frontend Sentry (PR-1, pra-beta). Vite reads VITE_* vars at build time and
# embeds them into the bundle. Leave unset for local dev to keep the SDK
# inert (no init, no network). Set per-environment in CI / deploy config.
# VITE_SENTRY_DSN_FRONTEND=https://...@sentry.io/...
# VITE_SENTRY_RELEASE=vipos-web@0.0.1

# ----- Background jobs (P2-04, future) -----
# REDIS_URL=rediss://default:token@host:port
