# ============================================================================
# VIPOS — Environment variables example
# ============================================================================
# Copy ke `.env` di repo root (atau `apps/backend/.env`) dan isi value asli.
# .env files di-gitignore — JANGAN commit secret asli.

# ----- Backend runtime -----
PORT=3001
NODE_ENV=development
JWT_SECRET=replace-me-with-32-byte-random-string

# CORS allowlist — comma-separated origins for cross-origin browsers.
# REQUIRED in production: backend throws at boot if NODE_ENV=production and
# this is empty (apps/backend/src/lib/security.js:resolveAllowlist).
# Same-origin requests (browser hitting the SPA at the same hostname, curl,
# server-to-server) are always allowed regardless of this setting.
# Examples:
#   CORS_ALLOWLIST=https://app.vipos.id,https://www.vipos.id
#   CORS_ALLOWLIST=http://103.74.5.44                # bare-IP HTTP staging
#   CORS_ALLOWLIST=*                                 # wildcard (logs warning)
# CORS_ALLOWLIST=

# ----- Database (P2-01) -----
# DATABASE_URL: runtime URL untuk Prisma client. Pakai connection pooler
# (PgBouncer) di Supabase port 6543 transaction mode.
#   format: postgresql://user:pass@host:6543/db?pgbouncer=true&connection_limit=1
# Untuk dev lokal pakai Docker Postgres:
#   docker run --rm -d -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=vipos -p 5433:5432 postgres:17-alpine
# DATABASE_URL=postgresql://postgres:dev@localhost:5433/vipos
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vipos

# RLS-aware dev (recommended sebelum testing multi-tenant):
# Postgres skip RLS untuk superuser/BYPASSRLS roles. Connecting sebagai
# `postgres` superuser di local dev membuat policy `FORCE ROW LEVEL SECURITY`
# tidak benar-benar enforced — cross-tenant data terlihat.
# Provision role `vipos_app` (NOSUPERUSER NOBYPASSRLS) dengan:
#   psql "$DIRECT_URL" -f apps/backend/scripts/setup-app-role.sql
# Lalu pakai connection string ini buat dev/test:
# DATABASE_URL=postgresql://vipos_app:apppass@localhost:5432/vipos
# Production note: Supabase service_role / cloud-managed app roles biasanya
# sudah non-superuser. Lihat docs/runbook/deploy-checklist.md §2 buat
# pre-deploy verification SQL.

# DIRECT_URL: HANYA untuk `prisma migrate` (butuh prepared statements yang
# tidak compatible dengan PgBouncer transaction mode). Di Supabase, pakai
# pooler hostname dengan port 5432 (session mode) — JANGAN pakai
# `db.<projectref>.supabase.co` karena IPv6-only di free tier.
#   format: postgresql://user:pass@aws-X-region.pooler.supabase.com:5432/db
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/vipos

# Legacy SQLite fallback (deprecated setelah P2-01b cutover). Boleh override
# untuk test isolation.
# VIPOS_DB_PATH=/path/to/vipos.db

# ----- Backup (P2-01a + P2-08) -----
# Local backup directory. Cron entry: `0 2 * * * /var/www/vipos/apps/backend/scripts/backup-postgres.sh`
# BACKUP_DIR=/var/backups/vipos
# RETENTION_DAYS=14

# Optional S3-compatible offload (Cloudflare R2 / Backblaze B2 / AWS S3).
# Aktif kalau S3_BUCKET di-set; backup auto-upload setelah local dump.
# S3_BUCKET=vipos-backup
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=auto

# ----- Observability -----
# Backend Sentry (P2-05). Reads at boot via apps/backend/src/lib/sentry.js.
# Leave unset to no-op locally — the SDK silently skips init.
# Production wire-up: docs/runbook/deploy-checklist.md §2.6.1
# SENTRY_DSN=https://<32-hex>@o<orgId>.ingest.us.sentry.io/<backendProjectId>
# SENTRY_ENV=production            # falls back to NODE_ENV
# SENTRY_RELEASE=vipos-backend@<git-sha>
# SENTRY_TRACES_SAMPLE_RATE=0.1    # default 0.1 (10% of requests)

# Frontend Sentry (PR-1, pra-beta). Vite reads VITE_* vars at *build time*
# and embeds them into the JS bundle — changing these requires a rebuild.
# Leave unset for local dev to keep the SDK inert (no init, no network).
# Production wire-up: docs/runbook/deploy-checklist.md §2.6.2
# VITE_SENTRY_DSN_FRONTEND=https://<32-hex>@o<orgId>.ingest.us.sentry.io/<frontendProjectId>
# VITE_SENTRY_RELEASE=vipos-web@<git-sha>

# ----- Background jobs (P2-04, future) -----
# REDIS_URL=rediss://default:token@host:port
