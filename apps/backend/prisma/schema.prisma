generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model app_settings {
  id         Int       @id @default(autoincrement())
  outlet_id  Int?
  category   String
  key        String
  value_json String
  updated_by Int?
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  outlets    outlets?  @relation(fields: [outlet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users      users?    @relation(fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([outlet_id, category, key])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model appointment_resources {
  id            Int            @id @default(autoincrement())
  name          String
  resource_type String         @default("room")
  capacity      Int?           @default(1)
  is_active     Int            @default(1)
  created_at    DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?      @default(now()) @db.Timestamptz(6)
  appointments  appointments[]
}

model appointment_services {
  id               Int          @id @default(autoincrement())
  appointment_id   Int
  product_id       Int?
  service_name     String
  qty              Int          @default(1)
  price            Float        @default(0)
  duration_minutes Int?         @default(0)
  subtotal         Float        @default(0)
  appointments     appointments @relation(fields: [appointment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products         products?    @relation(fields: [product_id], references: [id], onUpdate: NoAction)

  @@index([appointment_id], map: "idx_appointment_services_appt")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model appointments {
  id                    Int                    @id @default(autoincrement())
  ref_no                String                 @unique
  customer_id           Int?
  customer_name         String?
  customer_phone        String?
  staff_id              Int?
  resource_id           Int?
  start_at              DateTime               @db.Timestamptz(6)
  end_at                DateTime               @db.Timestamptz(6)
  duration_minutes      Int                    @default(30)
  status                String                 @default("PENDING")
  notes                 String?
  deposit_amount        Float?                 @default(0)
  total                 Float                  @default(0)
  transaction_id        Int?
  checked_in_at         DateTime?              @db.Timestamptz(6)
  completed_at          DateTime?              @db.Timestamptz(6)
  cancelled_at          DateTime?              @db.Timestamptz(6)
  cancel_reason         String?
  reminders_config      String?
  reminder_24h_sent_at  DateTime?              @db.Timestamptz(6)
  reminder_1h_sent_at   DateTime?              @db.Timestamptz(6)
  created_at            DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?              @default(now()) @db.Timestamptz(6)
  appointment_services  appointment_services[]
  customers             customers?             @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  appointment_resources appointment_resources? @relation(fields: [resource_id], references: [id], onUpdate: NoAction)
  staff                 staff?                 @relation(fields: [staff_id], references: [id], onUpdate: NoAction)
  transactions          transactions?          @relation(fields: [transaction_id], references: [id], onUpdate: NoAction)

  @@index([customer_id], map: "idx_appointments_customer")
  @@index([staff_id], map: "idx_appointments_staff")
  @@index([start_at], map: "idx_appointments_start")
  @@index([status], map: "idx_appointments_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model approval_chains {
  id               Int       @id @default(autoincrement())
  domain           String
  name             String
  threshold_amount Float?    @default(0)
  steps            String
  is_active        Int       @default(1)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)
}

model attendance_geofences {
  id          Int       @id @default(autoincrement())
  outlet_id   Int       @unique
  outlet_name String?
  latitude    Float?
  longitude   Float?
  radius_m    Int?      @default(100)
  strict_mode Int?      @default(0)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance_logs {
  id          Int       @id @default(autoincrement())
  employee_id Int
  log_type    String
  logged_at   DateTime  @db.Timestamptz(6)
  method      String    @default("manual")
  latitude    Float?
  longitude   Float?
  photo_url   String?
  note        String?
  is_off_site Int?      @default(0)
  approved_by Int?
  approved_at DateTime? @db.Timestamptz(6)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  employees   employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id], map: "idx_attendance_employee")
  @@index([logged_at], map: "idx_attendance_logged")
}

model b2b_delivery_order_items {
  id                    Int                    @id @default(autoincrement())
  delivery_order_id     Int
  sales_order_item_id   Int?
  product_id            Int?
  product_name          String
  qty                   Float
  b2b_delivery_orders   b2b_delivery_orders    @relation(fields: [delivery_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products              products?              @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  b2b_sales_order_items b2b_sales_order_items? @relation(fields: [sales_order_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([delivery_order_id], map: "idx_b2b_delivery_order_items_do")
}

model b2b_delivery_orders {
  id                       Int                        @id @default(autoincrement())
  number                   String                     @unique
  sales_order_id           Int?
  customer_id              Int?
  customer_name            String
  delivery_date            String
  expected_arrival         String?
  carrier                  String?
  driver                   String?
  status                   String                     @default("PREPARING")
  notes                    String?
  signature_url            String?
  stock_posted             Int                        @default(0)
  created_by               Int?
  created_at               DateTime?                  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?                  @default(now()) @db.Timestamptz(6)
  b2b_delivery_order_items b2b_delivery_order_items[]
  users                    users?                     @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers                customers?                 @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  b2b_sales_orders         b2b_sales_orders?          @relation(fields: [sales_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([sales_order_id], map: "idx_b2b_delivery_orders_so")
}

model b2b_invoice_items {
  id                    Int                    @id @default(autoincrement())
  invoice_id            Int
  sales_order_item_id   Int?
  product_id            Int?
  product_name          String
  qty                   Float
  unit_price            Float
  discount_percent      Float?                 @default(0)
  subtotal              Float
  b2b_invoices          b2b_invoices           @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products              products?              @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  b2b_sales_order_items b2b_sales_order_items? @relation(fields: [sales_order_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([invoice_id], map: "idx_b2b_invoice_items_inv")
}

model b2b_invoices {
  id                Int                 @id @default(autoincrement())
  number            String              @unique
  sales_order_id    Int?
  customer_id       Int?
  customer_name     String
  invoice_date      String
  due_date          String?
  status            String              @default("ISSUED")
  subtotal          Float               @default(0)
  tax_percent       Float               @default(0)
  tax_amount        Float               @default(0)
  discount_amount   Float               @default(0)
  total             Float               @default(0)
  down_payment      Float               @default(0)
  paid_amount       Float               @default(0)
  outstanding       Float               @default(0)
  notes             String?
  created_by        Int?
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?           @default(now()) @db.Timestamptz(6)
  b2b_invoice_items b2b_invoice_items[]
  users             users?              @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers         customers?          @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  b2b_sales_orders  b2b_sales_orders?   @relation(fields: [sales_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  b2b_receipts      b2b_receipts[]

  @@index([customer_id], map: "idx_b2b_invoices_customer")
  @@index([due_date], map: "idx_b2b_invoices_due")
  @@index([status], map: "idx_b2b_invoices_status")
}

model b2b_quotation_items {
  id               Int            @id @default(autoincrement())
  quotation_id     Int
  product_id       Int?
  product_name     String
  qty              Float
  unit_price       Float
  discount_percent Float?         @default(0)
  subtotal         Float
  products         products?      @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  b2b_quotations   b2b_quotations @relation(fields: [quotation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([quotation_id], map: "idx_b2b_quotation_items_qid")
}

model b2b_quotations {
  id                  Int                   @id @default(autoincrement())
  number              String                @unique
  customer_id         Int?
  customer_name       String
  quote_date          String
  valid_until         String?
  status              String                @default("DRAFT")
  subtotal            Float                 @default(0)
  tax_percent         Float                 @default(0)
  tax_amount          Float                 @default(0)
  discount_amount     Float                 @default(0)
  total               Float                 @default(0)
  notes               String?
  terms               String?
  converted_so_id     Int?
  created_by          Int?
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  b2b_quotation_items b2b_quotation_items[]
  users               users?                @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers           customers?            @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  b2b_sales_orders    b2b_sales_orders[]

  @@index([customer_id], map: "idx_b2b_quotations_customer")
  @@index([status], map: "idx_b2b_quotations_status")
}

model b2b_receipts {
  id              Int            @id @default(autoincrement())
  number          String         @unique
  invoice_id      Int
  customer_id     Int?
  payment_date    String
  method          String         @default("cash")
  amount          Float
  bank_account_id Int?
  ref_number      String?
  notes           String?
  created_by      Int?
  created_at      DateTime?      @default(now()) @db.Timestamptz(6)
  cash_accounts   cash_accounts? @relation(fields: [bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users?         @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers       customers?     @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  b2b_invoices    b2b_invoices   @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([invoice_id], map: "idx_b2b_receipts_invoice")
}

model b2b_sales_order_items {
  id                       Int                        @id @default(autoincrement())
  sales_order_id           Int
  product_id               Int?
  product_name             String
  qty                      Float
  qty_delivered            Float                      @default(0)
  qty_invoiced             Float                      @default(0)
  unit_price               Float
  discount_percent         Float?                     @default(0)
  subtotal                 Float
  b2b_delivery_order_items b2b_delivery_order_items[]
  b2b_invoice_items        b2b_invoice_items[]
  products                 products?                  @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  b2b_sales_orders         b2b_sales_orders           @relation(fields: [sales_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sales_order_id], map: "idx_b2b_sales_order_items_so")
}

model b2b_sales_orders {
  id                    Int                     @id @default(autoincrement())
  number                String                  @unique
  quotation_id          Int?
  customer_id           Int?
  customer_name         String
  order_date            String
  expected_delivery     String?
  status                String                  @default("NEW")
  subtotal              Float                   @default(0)
  tax_percent           Float                   @default(0)
  tax_amount            Float                   @default(0)
  discount_amount       Float                   @default(0)
  total                 Float                   @default(0)
  notes                 String?
  created_by            Int?
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?               @default(now()) @db.Timestamptz(6)
  b2b_delivery_orders   b2b_delivery_orders[]
  b2b_invoices          b2b_invoices[]
  b2b_sales_order_items b2b_sales_order_items[]
  users                 users?                  @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers             customers?              @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  b2b_quotations        b2b_quotations?         @relation(fields: [quotation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([customer_id], map: "idx_b2b_sales_orders_customer")
  @@index([status], map: "idx_b2b_sales_orders_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model capital_applications {
  id                      Int       @id @default(autoincrement())
  amount                  Float
  tenure_months           Int
  purpose                 String
  collateral              String?
  monthly_revenue         Float?
  status                  String    @default("submitted")
  pre_qualification_score Int?
  payload_json            String?
  submitted_by            Int?
  submitted_at            DateTime? @default(now()) @db.Timestamptz(6)
  reviewed_at             DateTime? @db.Timestamptz(6)
  users                   users?    @relation(fields: [submitted_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cash_accounts {
  id                                                               Int                 @id @default(autoincrement())
  kode                                                             String              @unique
  tipe                                                             String?             @default("detail")
  nama                                                             String
  kategori                                                         String?             @default("Kas & Bank")
  saldo_awal                                                       Float?              @default(0)
  is_active                                                        Int?                @default(1)
  created_at                                                       DateTime?           @default(now()) @db.Timestamptz(6)
  b2b_receipts                                                     b2b_receipts[]
  cash_transactions_cash_transactions_account_idTocash_accounts    cash_transactions[] @relation("cash_transactions_account_idTocash_accounts")
  cash_transactions_cash_transactions_account_to_idTocash_accounts cash_transactions[] @relation("cash_transactions_account_to_idTocash_accounts")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cash_transactions {
  id                                                           Int            @id @default(autoincrement())
  tanggal                                                      DateTime       @default(dbgenerated("CURRENT_DATE")) @db.Date
  tipe                                                         String
  account_id                                                   Int
  account_to_id                                                Int?
  kategori                                                     String?
  jumlah                                                       Float
  keterangan                                                   String?
  reference                                                    String?
  user_id                                                      Int?
  created_at                                                   DateTime?      @default(now()) @db.Timestamptz(6)
  cash_accounts_cash_transactions_account_idTocash_accounts    cash_accounts  @relation("cash_transactions_account_idTocash_accounts", fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cash_accounts_cash_transactions_account_to_idTocash_accounts cash_accounts? @relation("cash_transactions_account_to_idTocash_accounts", fields: [account_to_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                                                        users?         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([account_id], map: "idx_cash_transactions_account")
  @@index([tanggal], map: "idx_cash_transactions_tanggal")
}

model categories {
  id                Int          @id @default(autoincrement())
  name              String       @unique
  description       String?
  urutan            Int?         @default(0)
  department_id     Int?
  color             String?
  icon_url          String?
  is_tampil_di_menu Int?         @default(1)
  created_at        DateTime?    @default(now()) @db.Timestamptz(6)
  departments       departments? @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products          products[]
}

model commission_assignments {
  id                  Int               @id @default(autoincrement())
  transaction_id      Int
  employee_id         Int
  commission_group_id Int
  basis_amount        Float             @default(0)
  basis_qty           Int               @default(0)
  computed_amount     Float             @default(0)
  tier_percentage     Float?
  period_key          String?
  notes               String?
  created_at          DateTime?         @default(now()) @db.Timestamptz(6)
  commission_groups   commission_groups @relation(fields: [commission_group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users               users             @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transactions        transactions      @relation(fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id], map: "idx_commission_assign_employee")
  @@index([period_key], map: "idx_commission_assign_period")
  @@index([transaction_id], map: "idx_commission_assign_transaction")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model commission_groups {
  id                        Int                      @id @default(autoincrement())
  name                      String
  description               String?
  type                      String
  applies_to_scope          String                   @default("all")
  applies_to_role_keys      String?
  applies_to_employee_ids   String?
  applies_to_products_scope String                   @default("all")
  applies_to_category_ids   String?
  applies_to_product_ids    String?
  amount                    Float?
  amount_basis              String?                  @default("PER_TRANSACTION")
  tiers                     String?
  calc_period               String                   @default("MONTH")
  is_active                 Int?                     @default(1)
  created_at                DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?                @default(now()) @db.Timestamptz(6)
  commission_assignments    commission_assignments[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model consumer_app_config {
  id                 Int       @id
  app_name           String?
  app_icon_url       String?
  splash_image_url   String?
  primary_color      String?   @default("#04C99E")
  bundle_id_android  String?
  bundle_id_ios      String?
  play_store_url     String?
  app_store_url      String?
  status             String    @default("draft")
  provisioned_at     DateTime? @db.Timestamptz(6)
  published_at       DateTime? @db.Timestamptz(6)
  featured_promo_ids String?
  hidden_product_ids String?
  operating_hours    String?
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)
}

model coupon_redemptions {
  id             Int           @id @default(autoincrement())
  coupon_id      Int
  transaction_id Int?
  customer_id    Int?
  amount         Float?        @default(0)
  redeemed_at    DateTime?     @default(now()) @db.Timestamptz(6)
  coupons        coupons       @relation(fields: [coupon_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customers      customers?    @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transactions   transactions? @relation(fields: [transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([coupon_id], map: "idx_coupon_redemptions_coupon")
  @@index([customer_id], map: "idx_coupon_redemptions_customer")
}

model coupons {
  id                   Int                  @id @default(autoincrement())
  promo_id             Int
  code                 String               @unique
  batch_id             String?
  max_uses             Int?                 @default(1)
  used_count           Int?                 @default(0)
  assigned_customer_id Int?
  valid_from           DateTime?            @db.Timestamptz(6)
  valid_until          DateTime?            @db.Timestamptz(6)
  is_active            Int?                 @default(1)
  created_at           DateTime?            @default(now()) @db.Timestamptz(6)
  coupon_redemptions   coupon_redemptions[]
  customers            customers?           @relation(fields: [assigned_customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  promos               promos               @relation(fields: [promo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([is_active], map: "idx_coupons_active")
  @@index([batch_id], map: "idx_coupons_batch")
  @@index([promo_id], map: "idx_coupons_promo")
}

model customer_groups {
  id                Int         @id @default(autoincrement())
  name              String      @unique
  description       String?
  discount_percent  Float?      @default(0)
  points_multiplier Float?      @default(1)
  color             String?
  created_at        DateTime?   @default(now()) @db.Timestamptz(6)
  customers         customers[]
}

model customer_tag_map {
  customer_id   Int
  tag_id        Int
  created_at    DateTime?     @default(now()) @db.Timestamptz(6)
  customers     customers     @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer_tags customer_tags @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([customer_id, tag_id])
  @@index([customer_id], map: "idx_customer_tag_map_customer")
  @@index([tag_id], map: "idx_customer_tag_map_tag")
}

model customer_tags {
  id               Int                @id @default(autoincrement())
  name             String             @unique
  color            String?
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  customer_tag_map customer_tag_map[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model customers {
  id                            Int                             @id @default(autoincrement())
  kode                          String?                         @unique
  name                          String
  phone                         String?
  email                         String?
  address                       String?
  gender                        String?
  birth_date                    DateTime?                       @db.Date
  points                        Int?                            @default(0)
  deposit                       Float?                          @default(0)
  notes                         String?
  customer_group_id             Int?
  npwp                          String?
  id_card_no                    String?
  province                      String?
  city                          String?
  district                      String?
  is_active                     Int?                            @default(1)
