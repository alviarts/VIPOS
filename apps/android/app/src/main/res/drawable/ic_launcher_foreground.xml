<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground layer (P3-01e). White "V" mark designed
  inside the inner 72dp safe zone of the 108dp x 108dp canvas so it
  survives every launcher mask (circle / squircle / square / etc.).
  Stroked path with rounded caps for a friendlier silhouette.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M 32,33 L 54,80 L 76,33" />
</vector>
