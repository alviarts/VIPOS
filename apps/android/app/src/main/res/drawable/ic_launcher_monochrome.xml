<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon monochrome layer (P3-01e). Picked up by Android 13+
  when the user enables themed icons; the launcher tints this drawable
  with the active dynamic-color scheme. Same V mark as the foreground
  layer minus the brand white — Android handles the colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M 32,33 L 54,80 L 76,33" />
</vector>
