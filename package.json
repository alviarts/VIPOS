{
  "name": "vipos",
  "version": "1.0.0",
  "description": "VIPOS - Aplikasi POS/Kasir Modern (monorepo)",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n backend,web -c blue,green \"npm run dev:backend\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:backend": "npm run build:shared && npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev:web",
    "build:shared": "npm run build --workspace=packages/shared",
    "build": "npm run build:shared && npm run build --workspace=apps/web && npm run build --workspace=apps/backend --if-present",
    "build:web": "npm run build --workspace=apps/web",
    "build:backend": "npm run build --workspace=apps/backend --if-present",
    "start": "npm run start --workspace=apps/backend",
    "seed": "npm run seed --workspace=apps/backend",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
